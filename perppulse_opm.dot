// PerpPulse — OPM-inspired project framework rendered with Graphviz DOT.
//
// OPM-to-DOT conventions used here:
//   * Object              : rectangle
//   * Process             : ellipse, verb phrase
//   * Object state        : rounded rectangle, linked to its object with "state of"
//   * Agent link          : bold purple edge
//   * Instrument link     : dashed blue edge (the object enables a process but persists)
//   * Consumption/result  : solid edge into/out of a process
//   * Effect link         : dotted bidirectional edge
//   * In-zooming          : nested clusters that expose subprocesses of the system process
//
// Graphviz is used as a portable rendering target; it is not an ISO 19450
// interchange format. Explicit link labels preserve the intended OPM semantics.

digraph PerpPulseOPM {
  graph [
    rankdir=TB,
    compound=true,
    newrank=true,
    splines=polyline,
    nodesep=0.35,
    ranksep=0.75,
    pad=0.30,
    margin=0.08,
    bgcolor="#F7F9FC",
    fontname="Microsoft YaHei",
    fontsize=16,
    labelloc=t,
    label="PerpPulse — Real-Time Protocol-to-Wallet Risk Intelligence on Monad\nPrimary: Onchain Finance & Trading | Bounties: Perpl Analytics/Risk + Envio + Nansen"
  ];

  node [
    shape=box,
    style="filled",
    fillcolor="#EAF3FF",
    color="#38658C",
    fontcolor="#102A43",
    fontname="Microsoft YaHei",
    fontsize=10,
    margin="0.10,0.07"
  ];

  edge [
    color="#52667A",
    fontcolor="#334E68",
    fontname="Microsoft YaHei",
    fontsize=8,
    arrowsize=0.7
  ];

  // -------------------------------------------------------------------------
  // OPD-0: system purpose, beneficiary, external instruments, and value.
  // -------------------------------------------------------------------------
  implementation_status [
    shape=note,
    fillcolor="#E8F8EE",
    label="Verified Local Implementation · 2026-10-07\nFixture web/API + bounded live Envio account serving + v3 marks/covered funding\nProtocol analytics: 24h/7d/30d/coverage windows + deployment-history OI/collateral/skew\nRule-hashed risk signals + mark-shock stress + snapshot wallet comparison + Nansen label filter\nCompact PostgreSQL snapshots + hashed range manifests + same-cutoff quarantine\nPending: mainnet global backfill, cloud deployment, live Nansen, hosted public demo"
  ];
  implementation_status -> query_api [style=dashed, label="implemented local surface"];
  implementation_status -> evidence_manifest [style=dashed, label="implemented range evidence"];
  implementation_status -> protocol_mart [style=dashed, label="implemented windows and state"];
  implementation_status -> verified_signal_set [style=dashed, label="implemented rule-hashed signals"];

  subgraph cluster_opd0 {
    label="OPD-0 · System Function and Value";
    color="#7B61A8";
    penwidth=1.4;
    style="rounded,filled";
    fillcolor="#F7F2FF";

    user_agent [
      shape=box,
      style="rounded,filled,bold",
      fillcolor="#EFE6FF",
      color="#6B46A1",
      label="Trader / Risk Analyst\n<<Agent>>"
    ];

    judge_agent [
      shape=box,
      style="rounded,filled,bold",
      fillcolor="#EFE6FF",
      color="#6B46A1",
      label="Hackathon Judge\n<<Agent>>"
    ];

    decision_context [
      label="Decision Context\n<<Object>>"
    ];

    decision_fragmented [
      shape=box,
      style="rounded,filled",
      fillcolor="#FFF0F0",
      color="#B54747",
      label="fragmented / delayed\n<<State>>"
    ];

    decision_actionable [
      shape=box,
      style="rounded,filled",
      fillcolor="#E8F8EE",
      color="#25855A",
      label="prioritized / explainable\n<<State>>"
    ];

    delivering_intelligence [
      shape=ellipse,
      style="filled,bold",
      fillcolor="#FFF0C2",
      color="#A86E00",
      penwidth=1.8,
      label="Delivering Near-Real-Time\nPerpPulse Risk Intelligence\n<<System Process>>"
    ];

    perpl_instrument [
      style="dashed,filled",
      fillcolor="#F3F7FA",
      label="Perpl Protocol + API\n<<Environmental Object>>"
    ];

    envio_instrument [
      style="dashed,filled",
      fillcolor="#F3F7FA",
      label="Envio HyperSync / HyperIndex / HyperRPC\n<<Environmental Object>>"
    ];

    nansen_instrument [
      style="dashed,filled",
      fillcolor="#F3F7FA",
      label="Nansen Data / Labels / Behavior\n<<Environmental Object>>"
    ];

    read_only_boundary [
      style="dashed,filled",
      fillcolor="#F3F7FA",
      label="Read-Only Product Boundary\n<<Object>>\nno order placement · no wallet private keys\npublic chain/market data · server-side sponsor keys"
    ];

    intelligence_product [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="PerpPulse Product\n<<Object>>\nRisk Pulse + protocol → market → wallet → event drilldown\nwallet comparison + actionable alerts"
    ];

    decision_context -> decision_fragmented [
      style=dotted,
      arrowhead=none,
      label="state of",
      constraint=false
    ];
    decision_context -> decision_actionable [
      style=dotted,
      arrowhead=none,
      label="state of",
      constraint=false
    ];
    decision_fragmented -> delivering_intelligence [label="consumed state"];
    delivering_intelligence -> decision_actionable [label="result state"];
    delivering_intelligence -> intelligence_product [label="yields"];

    user_agent -> delivering_intelligence [
      style=bold,
      color="#6B46A1",
      fontcolor="#6B46A1",
      label="agent"
    ];
    perpl_instrument -> delivering_intelligence [
      style=dashed,
      color="#2F6FB0",
      label="instrument · domain truth"
    ];
    envio_instrument -> delivering_intelligence [
      style=dashed,
      color="#2F6FB0",
      label="instrument · chain data"
    ];
    nansen_instrument -> delivering_intelligence [
      style=dashed,
      color="#2F6FB0",
      label="instrument · wallet context"
    ];
    read_only_boundary -> delivering_intelligence [
      style=dashed,
      color="#2F6FB0",
      label="instrument · safety scope"
    ];
  }

  // -------------------------------------------------------------------------
  // OPD-1A: ingesting, canonicalizing, finalizing, and enriching data.
  // -------------------------------------------------------------------------
  subgraph cluster_data_plane {
    label="OPD-1A · Data Plane (in-zoomed system process)";
    color="#4C78A8";
    style="rounded,filled";
    fillcolor="#EEF5FC";

    monad_chain [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Monad Blocks, Transactions, Logs\n<<Environmental Object>>"
    ];

    perpl_api [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Perpl Public REST + Market WebSocket\n<<Environmental Object>>\ncontext · oracle/mark/bid/ask · OI/TVL\nfunding · candles/trades/order book · heartbeat sequence"
    ];

    perpl_sdk [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Perpl dex-sdk Snapshot / Trace\n<<Verification Instrument>>\nas-of-block exchange state + event trace"
    ];

    nansen_api [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Nansen Monad Wallet Context\n<<Environmental Object>>\naddress labels · Profiler · Smart Money flows/holdings"
    ];

    source_truth_contract [
      fillcolor="#EAF3FF",
      label="Source-of-Truth Contract\n<<Object>>\nEnvio/onchain = global account + position facts\nPerpl stream = low-latency market state\nPerpl snapshot/trace = reconciliation only\nNansen = behavioral context only"
    ];

    protocol_registry [
      fillcolor="#EAF3FF",
      label="Protocol + Schema Registry\n<<Object>>\nchain/exchange/deployment block · ABI/version\nmarket/token IDs · price/size/amount decimals"
    ];

    historical_backfill [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Backfilling Historical Events\n<<Process>>"
    ];

    realtime_capture [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Capturing Near-Real-Time Events\n<<Process>>"
    ];

    api_snapshotting [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Acquiring Perpl Reference Snapshots\n<<Process>>"
    ];

    market_state_capturing [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Capturing Point-in-Time Market State\n<<Process>>"
    ];

    market_reference [
      label="Point-in-Time Market Reference\n<<Object>>\noracle/mark/mid/bid/ask · order-book depth\nfunding · OI/TVL · decimals · as-of block/time"
    ];

    event_dataset [
      label="Canonical Event Dataset\n<<Object>>\nPartitioned by chain / block time / market\naddressable by as-of block"
    ];

    dataset_raw [
      shape=box,
      style="rounded,filled",
      fillcolor="#FFF8E6",
      color="#AA7A00",
      label="raw · append-only\n<<State>>"
    ];

    dataset_deduped [
      shape=box,
      style="rounded,filled",
      fillcolor="#FFF8E6",
      color="#AA7A00",
      label="normalized · deduplicated\n<<State>>"
    ];

    dataset_final [
      shape=box,
      style="rounded,filled",
      fillcolor="#E8F8EE",
      color="#25855A",
      label="finalized · reconciled\n<<State>>"
    ];

    dataset_quarantined [
      shape=box,
      style="rounded,filled",
      fillcolor="#FFF0F0",
      color="#B54747",
      label="affected range quarantined · replay pending\n<<State>>"
    ];

    normalizing [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Decoding, Normalizing, Deduplicating\n<<Process>>"
    ];

    reconciling [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Finalizing and Reconciling\n<<Process>>"
    ];

    checkpoint_lineage [
      label="Checkpoint + Lineage Registry\n<<Object>>\nhead/processed/finalized block · cursor · source\nschema/handler/rule version · run ID"
    ];

    event_identity [
      label="Event Identity Contract\n<<Object>>\n(chain_id, block_hash, tx_hash, log_index)"
    ];

    continuity_monitoring [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Detecting Gaps, Reorgs, and Staleness\n<<Process>>\nblock parent + heartbeat sequence + lag"
    ];

    deterministic_replaying [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Replaying Affected Ranges Deterministically\n<<Process>>\nfrom last valid checkpoint"
    ];

    ingestion_health [
      fillcolor="#FFF7E6",
      color="#A86E00",
      label="Ingestion + Data Quality Status\n<<Object>>\nlag · completeness · sequence gaps · reorg depth\ndecode failures · reconciliation delta · retry state"
    ];

    enriching_wallets [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Caching and Enriching Wallet Context\n<<Process>>\ncredit budget · TTL · 429 backoff"
    ];

    wallet_context [
      label="Wallet Context Features\n<<Object>>\nlabels · cohorts · Smart Money context · behavioral features\nendpoint · observed-at · cache age · provenance · warnings"
    ];

    monad_chain -> historical_backfill [
      style=dashed,
      color="#2F6FB0",
      label="instrument"
    ];
    envio_instrument -> historical_backfill [
      style=dashed,
      color="#2F6FB0",
      label="HyperSync"
    ];
    monad_chain -> realtime_capture [
      style=dashed,
      color="#2F6FB0",
      label="instrument"
    ];
    envio_instrument -> realtime_capture [
      style=dashed,
      color="#2F6FB0",
      label="HyperIndex / HyperRPC"
    ];
    perpl_api -> api_snapshotting [
      style=dashed,
      color="#2F6FB0",
      label="instrument"
    ];
    perpl_api -> market_state_capturing [
      style=dashed,
      color="#2F6FB0",
      label="instrument · public WebSocket"
    ];
    source_truth_contract -> historical_backfill [style=dashed, color="#2F6FB0", label="instrument"];
    source_truth_contract -> realtime_capture [style=dashed, color="#2F6FB0", label="instrument"];
    source_truth_contract -> market_state_capturing [style=dashed, color="#2F6FB0", label="instrument"];
    protocol_registry -> historical_backfill [style=dashed, color="#2F6FB0", label="instrument"];
    protocol_registry -> realtime_capture [style=dashed, color="#2F6FB0", label="instrument"];
    protocol_registry -> market_state_capturing [style=dashed, color="#2F6FB0", label="instrument"];
    historical_backfill -> dataset_raw [label="yields"];
    realtime_capture -> dataset_raw [label="yields"];
    api_snapshotting -> market_reference [label="adds reconciliation snapshot"];
    market_state_capturing -> market_reference [label="yields low-latency state"];

    event_dataset -> dataset_raw [style=dotted, arrowhead=none, label="state of", constraint=false];
    event_dataset -> dataset_deduped [style=dotted, arrowhead=none, label="state of", constraint=false];
    event_dataset -> dataset_final [style=dotted, arrowhead=none, label="state of", constraint=false];
    event_dataset -> dataset_quarantined [style=dotted, arrowhead=none, label="state of", constraint=false];

    dataset_raw -> normalizing [label="consumed state"];
    event_identity -> normalizing [style=dashed, color="#2F6FB0", label="instrument"];
    source_truth_contract -> normalizing [style=dashed, color="#2F6FB0", label="instrument"];
    protocol_registry -> normalizing [style=dashed, color="#2F6FB0", label="instrument"];
    checkpoint_lineage -> historical_backfill [style=dashed, color="#2F6FB0", label="instrument"];
    checkpoint_lineage -> realtime_capture [style=dashed, color="#2F6FB0", label="instrument"];
    normalizing -> dataset_deduped [label="result state"];
    dataset_deduped -> reconciling [label="consumed state"];
    perpl_api -> reconciling [style=dashed, color="#2F6FB0", label="instrument · cross-check"];
    perpl_sdk -> reconciling [style=dashed, color="#2F6FB0", label="instrument · golden snapshot/trace"];
    monad_chain -> reconciling [style=dashed, color="#2F6FB0", label="instrument · finality"];
    source_truth_contract -> reconciling [style=dashed, color="#2F6FB0", label="instrument"];
    protocol_registry -> reconciling [style=dashed, color="#2F6FB0", label="instrument"];
    market_reference -> reconciling [style=dashed, color="#2F6FB0", label="instrument · point-in-time cross-check"];
    reconciling -> dataset_final [label="result state"];
    reconciling -> checkpoint_lineage [label="updates"];
    reconciling -> ingestion_health [label="updates reconciliation delta"];

    dataset_raw -> continuity_monitoring [label="consumed observations"];
    market_reference -> continuity_monitoring [style=dashed, color="#2F6FB0", label="instrument · heartbeat/age"];
    checkpoint_lineage -> continuity_monitoring [style=dashed, color="#2F6FB0", label="instrument"];
    source_truth_contract -> continuity_monitoring [style=dashed, color="#2F6FB0", label="instrument"];
    continuity_monitoring -> ingestion_health [label="yields status"];
    continuity_monitoring -> dataset_quarantined [label="marks affected range"];
    dataset_quarantined -> deterministic_replaying [label="consumed state"];
    monad_chain -> deterministic_replaying [style=dashed, color="#2F6FB0", label="instrument"];
    envio_instrument -> deterministic_replaying [style=dashed, color="#2F6FB0", label="instrument · range backfill"];
    protocol_registry -> deterministic_replaying [style=dashed, color="#2F6FB0", label="instrument"];
    checkpoint_lineage -> deterministic_replaying [style=dashed, color="#2F6FB0", label="instrument"];
    deterministic_replaying -> dataset_deduped [label="restores normalized range"];
    deterministic_replaying -> checkpoint_lineage [label="records replay run"];

    dataset_final -> enriching_wallets [style=dashed, color="#2F6FB0", label="instrument"];
    nansen_api -> enriching_wallets [style=dashed, color="#2F6FB0", label="instrument"];
    nansen_instrument -> enriching_wallets [style=dashed, color="#2F6FB0", label="API / MCP / CLI"];
    source_truth_contract -> enriching_wallets [style=dashed, color="#2F6FB0", label="instrument · context-only boundary"];
    enriching_wallets -> wallet_context [label="yields derived context"];
  }

  // -------------------------------------------------------------------------
  // OPD-1B: protocol metrics, wallet accounting, and prioritized risk signals.
  // -------------------------------------------------------------------------
  subgraph cluster_intelligence_plane {
    label="OPD-1B · Intelligence Plane";
    color="#D58A00";
    style="rounded,filled";
    fillcolor="#FFF8E8";

    metric_contract [
      fillcolor="#EAF3FF",
      label="Versioned Metric Contract\n<<Object>>\nname · grain · UTC window · dimensions · decimals\nfinality · formula · methodology · owner · version"
    ];

    protocol_aggregating [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Aggregating Protocol Intelligence\n<<Process>>"
    ];

    wallet_reconstructing [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Reconstructing Canonical Position Lifecycle\n<<Process>>\nopen → increase/reduce → funding/fees → liquidate/close"
    ];

    position_ledger [
      label="Canonical Position Lifecycle Ledger\n<<Object>>\nappend-only events · one source of truth\nmarket/account/position IDs · block/time · event identity"
    ];

    wallet_accounting [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Calculating Point-in-Time Wallet Accounting\n<<Process>>\nstrict as-of cutoff · finite-value checks"
    ];

    protocol_mart [
      label="Protocol Metric Mart\n<<Object>>\n24h / 7d / 30d / history\nvolume · OI · TVL · fees/revenue · active users\ndeposits · withdrawals · net flow\nmarket/asset split · long/short skew\nliquidations · funding rates"
    ];

    wallet_mart [
      label="Wallet Intelligence Mart\n<<Object>>\nopen positions · size · entry · leverage\nunrealized PnL · liquidation price\ntrade ledger · realized PnL\nwin rate · profit factor · max drawdown\nstreak · holding time · best/worst markets\nportfolio and profit overview"
    ];

    scenario_contract [
      label="Deterministic Risk Scenario Contract\n<<Object>>\nscenario fingerprint · as-of cutoff · market shocks\nfunding/liquidity assumptions · model/rule version"
    ];

    stress_testing [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Replaying Stress and Liquidation Scenarios\n<<Process>>\nno forecasting · no future observations"
    ];

    stress_result [
      label="Stress Result Set\n<<Object>>\nliquidation-at-risk notional · cascade bands\ncollateral shortfall · affected wallets/markets · input hash"
    ];

    competitor_context [
      style="dashed,filled",
      fillcolor="#F5F5F5",
      color="#8A8A8A",
      label="Competitor / Market Share Data\n<<Optional Object>>"
    ];

    risk_assessing [
      shape=ellipse,
      style="filled,bold",
      fillcolor="#FFE0B2",
      color="#B65F00",
      label="Assessing Risk and Detecting Anomalies\n<<Process>>"
    ];

    behavioral_reasoning [
      shape=ellipse,
      style="dashed,filled",
      fillcolor="#F8F0FF",
      color="#7B61A8",
      label="Explaining Behavioral Patterns with AI\n<<Optional Process>>"
    ];

    risk_signal_set [
      fillcolor="#FFECEC",
      color="#B54747",
      label="Candidate Risk Signal Set\n<<Object>>\ncrowding OI/TVL · liquidation-distance/cascade bands\nfunding/price divergence · concentration · net outflow\nSmart-Money divergence (context)\nrule ID · severity · evidence · affected entity · freshness"
    ];

    signal_quality_policy [
      label="Fail-Closed Signal Quality Policy\n<<Object>>\nrequired sources · max age · completeness · finality\nfinite metrics · reconciliation tolerance · rule version"
    ];

    gating_signals [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Gating Signals by Evidence Quality\n<<Process>>\nstale/invalid/incomplete signals are suppressed visibly"
    ];

    verified_signal_set [
      fillcolor="#FFECEC",
      color="#B54747",
      label="Eligible Risk Signal Set\n<<Object>>\nwhy now · confidence · source status · evidence refs\nas-of block/time · rule/input hash"
    ];

    signal_prioritizing [
      shape=ellipse,
      style="filled,bold",
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Ranking and Explaining Signals\n<<Process>>"
    ];

    prioritized_feed [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="Prioritized Signal Feed\n<<Object>>\nimportant changes first · raw detail on demand"
    ];

    materializing_semantic_api [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Materializing Versioned Analytics API\n<<Process>>\ndefine metrics once · incremental aggregates · bounded cache"
    ];

    query_api [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="PerpPulse Query Contract\n<<Object>>\nprotocol / market / wallet / risk endpoints\nas-of + freshness + pagination cursor + provenance\ncache key includes metric/schema version and filters"
    ];

    dataset_final -> protocol_aggregating [style=dashed, color="#2F6FB0", label="instrument"];
    dataset_final -> wallet_reconstructing [style=dashed, color="#2F6FB0", label="instrument"];
    market_reference -> protocol_aggregating [style=dashed, color="#2F6FB0", label="instrument · point-in-time"];
    metric_contract -> protocol_aggregating [style=dashed, color="#2F6FB0", label="instrument"];
    metric_contract -> wallet_reconstructing [style=dashed, color="#2F6FB0", label="instrument"];
    competitor_context -> protocol_aggregating [style=dashed, color="#8A8A8A", label="optional instrument"];
    protocol_aggregating -> protocol_mart [label="yields"];
    wallet_reconstructing -> position_ledger [label="yields"];
    position_ledger -> wallet_accounting [label="consumed as-of"];
    market_reference -> wallet_accounting [style=dashed, color="#2F6FB0", label="instrument · no look-ahead"];
    metric_contract -> wallet_accounting [style=dashed, color="#2F6FB0", label="instrument"];
    wallet_accounting -> wallet_mart [label="yields"];

    protocol_mart -> stress_testing [style=dashed, color="#2F6FB0", label="instrument"];
    wallet_mart -> stress_testing [style=dashed, color="#2F6FB0", label="instrument"];
    market_reference -> stress_testing [style=dashed, color="#2F6FB0", label="instrument · as-of"];
    scenario_contract -> stress_testing [style=dashed, color="#2F6FB0", label="instrument"];
    stress_testing -> stress_result [label="yields"];

    protocol_mart -> risk_assessing [style=dashed, color="#2F6FB0", label="instrument"];
    wallet_mart -> risk_assessing [style=dashed, color="#2F6FB0", label="instrument"];
    stress_result -> risk_assessing [style=dashed, color="#2F6FB0", label="instrument"];
    wallet_context -> risk_assessing [style=dashed, color="#2F6FB0", label="instrument · context only"];
    risk_assessing -> risk_signal_set [label="yields"];

    wallet_mart -> behavioral_reasoning [style=dashed, color="#7B61A8", label="optional instrument"];
    wallet_context -> behavioral_reasoning [style=dashed, color="#7B61A8", label="optional instrument"];
    behavioral_reasoning -> risk_signal_set [style=dotted, color="#7B61A8", label="adds explanation; never overwrites facts"];

    risk_signal_set -> gating_signals [label="consumed"];
    ingestion_health -> gating_signals [style=dashed, color="#2F6FB0", label="instrument"];
    signal_quality_policy -> gating_signals [style=dashed, color="#2F6FB0", label="instrument"];
    gating_signals -> verified_signal_set [label="yields eligible or suppressed status"];
    verified_signal_set -> signal_prioritizing [label="consumed"];
    protocol_mart -> signal_prioritizing [style=dashed, color="#2F6FB0", label="instrument · evidence"];
    wallet_mart -> signal_prioritizing [style=dashed, color="#2F6FB0", label="instrument · evidence"];
    signal_prioritizing -> prioritized_feed [label="yields"];

    protocol_mart -> materializing_semantic_api [label="consumed"];
    wallet_mart -> materializing_semantic_api [label="consumed"];
    prioritized_feed -> materializing_semantic_api [label="consumed"];
    metric_contract -> materializing_semantic_api [style=dashed, color="#2F6FB0", label="instrument"];
    ingestion_health -> materializing_semantic_api [style=dashed, color="#2F6FB0", label="instrument · freshness"];
    materializing_semantic_api -> query_api [label="yields"];
  }

  // -------------------------------------------------------------------------
  // OPD-1C: product interaction; protocol-to-wallet drilldown preserves context.
  // -------------------------------------------------------------------------
  subgraph cluster_experience_plane {
    label="OPD-1C · Signal-First Product Experience";
    color="#2F855A";
    style="rounded,filled";
    fillcolor="#EFFAF3";

    exploration_workspace [
      label="Exploration Workspace\n<<Object>>"
    ];

    protocol_state [
      shape=box,
      style="rounded,filled",
      fillcolor="#E8F8EE",
      color="#25855A",
      label="protocol Risk Pulse view\n<<State>>\ntop 3 signals first · KPI + time-series + flows\nmarket/asset breakdown · freshness always visible"
    ];

    wallet_state [
      shape=box,
      style="rounded,filled",
      fillcolor="#E8F8EE",
      color="#25855A",
      label="wallet deep-dive view\n<<State>>\ncanonical positions/ledger/performance\nNansen labels/context visually separated · evidence timeline"
    ];

    comparison_state [
      shape=box,
      style="rounded,filled",
      fillcolor="#E8F8EE",
      color="#25855A",
      label="wallet comparison view\n<<State>>\nsaved addresses side-by-side · normalized statistics\ncohort percentiles · exposure overlap"
    ];

    event_state [
      shape=box,
      style="rounded,filled",
      fillcolor="#E8F8EE",
      color="#25855A",
      label="event evidence view\n<<State>>\nblock/tx/log · decoded inputs · lifecycle transition\nmetric/rule version · source links"
    ];

    serving_protocol [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Serving Protocol View\n<<Process>>"
    ];

    searching_wallet [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Searching Global Address\n<<Process>>"
    ];

    drilling_navigation [
      shape=ellipse,
      style="filled,bold",
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Drilling Down and Rolling Up\n<<Process>>\npreserve time range · market · filters"
    ];

    comparing_wallets [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Saving and Comparing Wallets\n<<Process>>"
    ];

    opening_evidence [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Opening Event-Level Evidence\n<<Process>>"
    ];

    alerting [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Publishing Near-Real-Time Alerts\n<<Process>>"
    ];

    alert_object [
      fillcolor="#FFECEC",
      color="#B54747",
      label="Actionable Alert\n<<Object>>\nwhat changed · why now · why it matters · confidence\ndata status · supporting facts · rule hash · deep link"
