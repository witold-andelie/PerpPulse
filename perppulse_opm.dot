  }

  // -------------------------------------------------------------------------
  // OPD-1D: verification and judge-facing evidence using official Rules v2.
  // -------------------------------------------------------------------------
  subgraph cluster_evidence {
    label="OPD-1D · Verification and Judge-Facing Evidence (Metropolis Rules v2)";
    color="#A44A3F";
    style="rounded,filled";
    fillcolor="#FFF4F2";

    judge_criteria [
      fillcolor="#FFF7E6",
      color="#A86E00",
      label="Official Scoring + Bounty Fit\n<<Object>>\nall tracks: quality 20 · technical 20 · Monad 20\ntrack fit 20 · innovation/impact 20\nsponsors: requirements 40 · implementation 30\nMonad 20 · innovation 10\nplus critical-time freshness · drilldown · signal-first UX"
    ];

    submission_requirements [
      fillcolor="#FFF7E6",
      color="#A86E00",
      label="Mandatory Submission Contract\n<<Object>>\nworking Monad-mainnet product · public GitHub + OSI license\ncomplete source · setup README · attribution + AI disclosure\ncommit history in build window · docs · addresses/tx hashes\npublic ≤3-minute operating demo"
    ];

    measuring_freshness [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Measuring End-to-End Freshness\n<<Process>>"
    ];

    validating_correctness [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Validating Metrics, Accounting, and Point-in-Time Safety\n<<Process>>\nunique/non-null/invariant/finite checks · no future data"
    ];

    proving_navigation [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Demonstrating Insight Navigation\n<<Process>>"
    ];

    tracing_integrations [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Tracing and Ablating Sponsor Integrations\n<<Process>>\nshow degradation without Envio or Nansen"
    ];

    golden_fixtures [
      label="Golden Fixture Set\n<<Object>>\nknown wallets + full position lifecycles\nliquidation/funding/partial-close cases · missing/reorg cases\nPerpl dex-sdk snapshot/trace expectations"
    ];

    recording_runs [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Recording Reproducible Evidence Runs\n<<Process>>"
    ];

    evidence_manifest [
      label="Append-Only Run Manifest\n<<Object>>\nrequest/scenario fingerprint · as-of cutoff · input/output hashes\nsource/schema/rule versions · Git SHA · timestamps · status/errors"
    ];

    freshness_evidence [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="Freshness + Recovery Evidence\n<<Object>>\nevent → ingest → materialization → UI timestamps\nmeasured p50/p95 lag · heartbeat gaps · reorg/quarantine/replay\nstale-data and degraded-source indicators"
    ];

    correctness_evidence [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="Correctness Evidence\n<<Object>>\nsource + dex-sdk reconciliation · invariant and fixture results\nPnL/flow formulas · finality · missing blocks · deterministic replay\nstrict as-of proof · visible failures, never silent zeroes"
    ];

    ux_evidence [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="Product Evidence\n<<Object>>\nprotocol anomaly → market → wallet → event proof\nas-of filters preserved · top signals before raw tables\ncanonical facts visibly distinct from Nansen context"
    ];

    sponsor_evidence [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="Integration + Ablation Evidence\n<<Object>>\nPerpl-specific risk outcome + snapshot/trace match\nEnvio powers backfill/reorg-aware live core pipeline\nNansen changes context/ranking, not canonical facts\ngracious degraded mode with explicit limitations"
    ];

    packaging_submission [
      shape=ellipse,
      style="filled,bold",
      fillcolor="#FFE0B2",
      color="#B65F00",
      label="Packaging Reproducible Submission\n<<Process>>"
    ];

    submission_package [
      fillcolor="#E8F8EE",
      color="#25855A",
      penwidth=1.5,
      label="Judge-Ready PerpPulse Submission\n<<Object>>\nMonad-mainnet app · seeded demo path · public licensed repository\narchitecture/data dictionary · tests · latency/correctness dashboard\n≤3-minute video + sponsor-specific evidence"
    ];

    evaluating_submission [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Evaluating Submission\n<<External Process>>"
    ];

    evaluation_outcome [
      fillcolor="#EFE6FF",
      color="#6B46A1",
      label="Evaluation Outcome\n<<Object>>"
    ];

    dataset_final -> measuring_freshness [style=dashed, color="#2F6FB0", label="instrument"];
    prioritized_feed -> measuring_freshness [style=dashed, color="#2F6FB0", label="instrument"];
    ingestion_health -> measuring_freshness [style=dashed, color="#2F6FB0", label="instrument"];
    measuring_freshness -> freshness_evidence [label="yields"];

    metric_contract -> validating_correctness [style=dashed, color="#2F6FB0", label="instrument"];
    protocol_mart -> validating_correctness [style=dashed, color="#2F6FB0", label="instrument"];
    wallet_mart -> validating_correctness [style=dashed, color="#2F6FB0", label="instrument"];
    scenario_contract -> validating_correctness [style=dashed, color="#2F6FB0", label="instrument"];
    golden_fixtures -> validating_correctness [style=dashed, color="#2F6FB0", label="instrument"];
    perpl_sdk -> validating_correctness [style=dashed, color="#2F6FB0", label="instrument"];
    validating_correctness -> correctness_evidence [label="yields"];

    protocol_state -> proving_navigation [style=dashed, color="#2F6FB0", label="instrument"];
    wallet_state -> proving_navigation [style=dashed, color="#2F6FB0", label="instrument"];
    comparison_state -> proving_navigation [style=dashed, color="#2F6FB0", label="instrument"];
    proving_navigation -> ux_evidence [label="yields"];

    perpl_instrument -> tracing_integrations [style=dashed, color="#2F6FB0", label="instrument"];
    envio_instrument -> tracing_integrations [style=dashed, color="#2F6FB0", label="instrument"];
    nansen_instrument -> tracing_integrations [style=dashed, color="#2F6FB0", label="instrument"];
    source_truth_contract -> tracing_integrations [style=dashed, color="#2F6FB0", label="instrument"];
    tracing_integrations -> sponsor_evidence [label="yields"];

    freshness_evidence -> recording_runs [label="consumed"];
    correctness_evidence -> recording_runs [label="consumed"];
    sponsor_evidence -> recording_runs [label="consumed"];
    recording_runs -> evidence_manifest [label="yields"];

    freshness_evidence -> packaging_submission [label="consumed"];
    correctness_evidence -> packaging_submission [label="consumed"];
    ux_evidence -> packaging_submission [label="consumed"];
    sponsor_evidence -> packaging_submission [label="consumed"];
    evidence_manifest -> packaging_submission [label="consumed"];
    submission_requirements -> packaging_submission [style=dashed, color="#2F6FB0", label="instrument · compliance"];
    intelligence_product -> packaging_submission [style=dashed, color="#2F6FB0", label="instrument · deployed product"];
    packaging_submission -> submission_package [label="yields"];

    judge_agent -> evaluating_submission [style=bold, color="#6B46A1", label="agent"];
    judge_criteria -> evaluating_submission [style=dashed, color="#2F6FB0", label="instrument"];
    submission_package -> evaluating_submission [label="consumed for review"];
    evaluating_submission -> evaluation_outcome [label="yields"];
  }

  // -------------------------------------------------------------------------
  // OPD-1E: planned GCP deployment and FinOps. No resources are provisioned.
  // -------------------------------------------------------------------------
  subgraph cluster_gcp_plane {
    label="OPD-1E · GCP Deployment and FinOps (foundation live in europe-west3; Cloud Run not deployed)";
    color="#4285F4";
    style="rounded,filled";
    fillcolor="#F2F7FF";

    deployment_blueprint [
      label="GCP Deployment Blueprint\n<<Object>>\neurope-west3 Frankfurt · separate runtime identity\nleast-purpose IAM · reproducible containers · no embedded secrets"
    ];

    cloud_run_worker [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud Run Worker Pool\n<<Planned Infrastructure Object>>\n1 vCPU / 512 MiB baseline · one always-on instance\nEnvio indexer + Perpl market stream consumers"
    ];

    cloud_sql [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud SQL for PostgreSQL\n<<Planned Infrastructure Object>>\ndb-g1-small starting point · 20 GiB\ncanonical facts + checkpoints + serving marts"
    ];

    cloud_run_service [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud Run API + Web\n<<Planned Infrastructure Object>>\nmin 0 · max 3 · read-only public surface"
    ];

    cloud_jobs [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud Run Jobs + Scheduler\n<<Planned Infrastructure Object>>\nbounded backfill · reconciliation · fixture replay · quality checks"
    ];

    gcs_archive [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud Storage Evidence Archive\n<<Planned Infrastructure Object>>\nraw snapshots · golden fixtures · run manifests\n30-day lifecycle for disposable artifacts"
    ];

    bigquery_optional [
      style="dashed,filled",
      fillcolor="#F5F5F5",
      color="#8A8A8A",
      label="BigQuery Hourly Mart + Billing Export\n<<Optional Infrastructure Object>>\nbenchmark analytical scans only after Postgres baseline"
    ];

    secret_manager [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Secret Manager\n<<Planned Infrastructure Object>>\nNansen credentials and internal tokens · runtime-only access"
    ];

    cloud_observability [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud Logging + Monitoring\n<<Planned Infrastructure Object>>\ntrace/run IDs · lag/SLO · error/retry/reorg alerts · billing export"
    ];

    artifact_pipeline [
      style="dashed,filled",
      fillcolor="#F8FAFC",
      label="Cloud Build + Artifact Registry\n<<Planned Infrastructure Object>>\nimmutable image digest · Git SHA provenance"
    ];

    provisioning_runtime [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Provisioning Reproducible Runtime\n<<Planned Process>>"
    ];

    operating_runtime [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Operating Live Data and Serving Planes\n<<Planned Process>>"
    ];

    running_credit_campaign [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Running September Evidence Campaign\n<<Planned Process>>\nhistorical backfill · deterministic replay · gap/reorg drill\n7–14 day soak · query load test · sponsor ablation"
    ];

    gcp_budget [
      fillcolor="#FFF7E6",
      color="#A86E00",
      label="Owner-Authorized GCP Envelope\n<<Object>>\nproject-5e761e8c-65aa-4033-8cb · europe-west3\nbilling 01B820-8960C8-EFE153 · ceiling EUR 350\nworking target EUR 180–220 · remainder is reserve\nSQL db-g1-small live · Cloud Run worker not deployed"
    ];

    guarding_cost [
      shape=ellipse,
      fillcolor="#FFF0C2",
      color="#A86E00",
      label="Guarding Cost and Capacity\n<<Process>>\nlabels · min/max instances · job caps · log retention\nalerts at 25/50/75/90/100 percent of EUR 350 · SQL stop script"
    ];

    budget_status [
      fillcolor="#E8F8EE",
      color="#25855A",
      label="Cost + Capacity Status\n<<Object>>\nactual vs forecast · credits included/excluded · daily burn\nremaining runway · service-level breakdown\nwarning: billing budgets alert; they are not hard caps"
    ];

    deployment_blueprint -> provisioning_runtime [label="consumed"];
    artifact_pipeline -> provisioning_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    secret_manager -> provisioning_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    provisioning_runtime -> cloud_run_worker [label="configures"];
    provisioning_runtime -> cloud_sql [label="configures"];
    provisioning_runtime -> cloud_run_service [label="configures"];
    provisioning_runtime -> cloud_jobs [label="configures"];

    cloud_run_worker -> operating_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_sql -> operating_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_run_service -> operating_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_jobs -> operating_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    gcs_archive -> operating_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_observability -> operating_runtime [style=dashed, color="#2F6FB0", label="instrument"];
    dataset_final -> operating_runtime [label="consumed by deployed data plane"];
    query_api -> operating_runtime [label="consumed by deployed serving plane"];

    cloud_jobs -> running_credit_campaign [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_sql -> running_credit_campaign [style=dashed, color="#2F6FB0", label="instrument"];
    gcs_archive -> running_credit_campaign [style=dashed, color="#2F6FB0", label="instrument"];
    bigquery_optional -> running_credit_campaign [style=dashed, color="#8A8A8A", label="optional instrument"];
    golden_fixtures -> running_credit_campaign [style=dashed, color="#2F6FB0", label="instrument"];
    running_credit_campaign -> evidence_manifest [label="adds benchmark runs"];

    gcp_budget -> guarding_cost [label="consumed"];
    cloud_observability -> guarding_cost [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_run_worker -> guarding_cost [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_sql -> guarding_cost [style=dashed, color="#2F6FB0", label="instrument"];
    cloud_jobs -> guarding_cost [style=dashed, color="#2F6FB0", label="instrument"];
    guarding_cost -> budget_status [label="yields"];
  }

  // In-zooming trace from the system process to its first concrete subprocess.
  delivering_intelligence -> historical_backfill [
    style=dotted,
    color="#7B61A8",
    fontcolor="#7B61A8",
    label="in-zoomed as",
    ltail=cluster_opd0,
    lhead=cluster_data_plane,
    constraint=false
  ];

  // -------------------------------------------------------------------------
  // Legend: keeps the DOT rendering self-describing.
  // -------------------------------------------------------------------------
  subgraph cluster_legend {
    label="OPM-to-DOT Legend";
    color="#9AA5B1";
    style="rounded,dashed";

    legend_object [label="Object", fillcolor="#EAF3FF"];
    legend_process [shape=ellipse, label="Transforming Object\nProcess", fillcolor="#FFF0C2", color="#A86E00"];
    legend_state [shape=box, style="rounded,filled", label="object state", fillcolor="#F4F7FA"];
    legend_agent [shape=box, style="rounded,filled,bold", label="Agent", fillcolor="#EFE6FF", color="#6B46A1"];

    legend_object -> legend_process [label="consumption / input"];
    legend_process -> legend_state [label="result"];
    legend_agent -> legend_process [style=bold, color="#6B46A1", label="agent"];
    legend_object -> legend_process [style=dashed, color="#2F6FB0", label="instrument", constraint=false];
  }
}
