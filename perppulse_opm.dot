    navigation_context [
      label="Navigation Context\n<<Object>>\nas-of block/time · window · market/asset · wallet\nselected comparison set · stable shareable URL"
    ];

    exploration_workspace -> protocol_state [style=dotted, arrowhead=none, label="state of", constraint=false];
    exploration_workspace -> wallet_state [style=dotted, arrowhead=none, label="state of", constraint=false];
    exploration_workspace -> comparison_state [style=dotted, arrowhead=none, label="state of", constraint=false];
    exploration_workspace -> event_state [style=dotted, arrowhead=none, label="state of", constraint=false];

    query_api -> serving_protocol [style=dashed, color="#2F6FB0", label="instrument"];
    serving_protocol -> protocol_state [label="yields"];

    user_agent -> searching_wallet [style=bold, color="#6B46A1", label="agent"];
    query_api -> searching_wallet [style=dashed, color="#2F6FB0", label="instrument"];
    searching_wallet -> wallet_state [label="yields"];

    user_agent -> drilling_navigation [style=bold, color="#6B46A1", label="agent"];
    protocol_state -> drilling_navigation [label="source state"];
    wallet_state -> drilling_navigation [label="source state"];
    event_state -> drilling_navigation [label="source state"];
    navigation_context -> drilling_navigation [style=dashed, color="#2F6FB0", label="instrument"];
    drilling_navigation -> protocol_state [label="result state"];
    drilling_navigation -> wallet_state [label="result state"];
    drilling_navigation -> event_state [label="result state"];
    drilling_navigation -> navigation_context [label="updates"];

    user_agent -> comparing_wallets [style=bold, color="#6B46A1", label="agent"];
    wallet_state -> comparing_wallets [label="consumed selection"];
    navigation_context -> comparing_wallets [style=dashed, color="#2F6FB0", label="instrument"];
    comparing_wallets -> comparison_state [label="yields"];

    user_agent -> opening_evidence [style=bold, color="#6B46A1", label="agent"];
    verified_signal_set -> opening_evidence [style=dashed, color="#2F6FB0", label="instrument · evidence refs"];
    position_ledger -> opening_evidence [style=dashed, color="#2F6FB0", label="instrument"];
    navigation_context -> opening_evidence [style=dashed, color="#2F6FB0", label="instrument"];
